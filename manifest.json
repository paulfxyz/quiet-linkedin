{
  "manifest_version": 3,
  "name": "Quiet, LinkedIn!",
  "version": "1.1.1",
  "description": "A quieter LinkedIn for zero-inbox workflows. Hides Home and Notifications badges without changing your notifications.",
  "homepage_url": "https://github.com/paulfxyz/quiet-linkedin",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "css": ["src/quiet.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
