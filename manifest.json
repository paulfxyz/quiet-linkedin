{
  "manifest_version": 3,
  "name": "Quiet, LinkedIn!",
  "version": "1.0.0",
  "description": "Hides the red notification badges on LinkedIn's Home and Notifications icons.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "css": ["src/quiet.css"],
      "run_at": "document_start"
    }
  ]
}
